{% comment %}
  Dynamic Review Badge Block for Storefront Product Page
{% endcomment %}

{% if template.name == 'product' or template contains 'product' %}
<link rel="stylesheet" href="/apps/reviews/widget.css?v=3.8" id="rw-widget-style">

<div 
  class="dynamic-review-badge-wrapper"
  data-product-id="{{ product.id }}"
  data-product-handle="{{ product.handle }}"
  data-shop="{{ shop.permanent_domain }}"
  style="--drb-star-color: {{ block.settings.star_color }}; --drb-text-color: {{ block.settings.text_color }}; --drb-font-size: {{ block.settings.font_size }}px;"
>
  <div class="dynamic-review-badge-content" id="drb-content-{{ block.id }}">
    <span class="dynamic-review-badge-stars" id="drb-stars-{{ block.id }}">
      ★★★★★
    </span>
    <span class="dynamic-review-badge-count" id="drb-count-{{ block.id }}">
      0 reviews
    </span>
  </div>
</div>

<script src="/apps/reviews/widget.js?v=3.8" defer="defer"></script>
{% endif %}

{% schema %}
{
  "name": "Dynamic Review Badge",
  "target": "section",
  "settings": [
    {
      "type": "color",
      "id": "star_color",
      "label": "Star Rating Color",
      "default": "#ffb400"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#2c3e50"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 12,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Font Size",
      "default": 14
    }
  ]
}
{% endschema %}
