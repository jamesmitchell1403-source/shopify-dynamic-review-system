{% comment %}
  Revio: Review Widget - App Embed for Storefront
{% endcomment %}

{% if template.name == 'product' or template contains 'product' %}
<link rel="stylesheet" href="{{ 'review-widget.css' | asset_url }}" id="rw-widget-style">

<div
  id="dynamic-review-widget-root"
  data-product-id="{{ product.id }}"
  data-product-handle="{{ product.handle }}"
  data-shop="{{ shop.permanent_domain }}"
></div>

<script src="{{ 'review-widget.js' | asset_url }}" defer="defer"></script>
{% endif %}

{% schema %}
{
  "name": "Revio: Review Widget",
  "target": "body",
  "settings": [
    {
      "type": "select",
      "id": "position_override",
      "label": "Card Position",
      "options": [
        { "value": "default", "label": "Use App Settings" },
        { "value": "bottom-left", "label": "Bottom Left" },
        { "value": "bottom-right", "label": "Bottom Right" }
      ],
      "default": "default"
    }
  ]
}
{% endschema %}
