{% comment %}
  Dynamic Review Widget Liquid Block for Storefront - Product Page Only
{% endcomment %}

{% if template.name == 'product' or template contains 'product' %}
<link rel="stylesheet" href="/apps/reviews/widget.css?v=4.0" id="rw-widget-style">

<div
  id="dynamic-review-widget-root"
  data-product-id="{{ product.id }}"
  data-shop="{{ shop.permanent_domain }}"
></div>

<script src="/apps/reviews/widget.js?v=4.0" defer="defer"></script>
{% endif %}

{% schema %}
{
  "name": "Dynamic Review Widget",
  "target": "body",
  "settings": [
    {
      "type": "select",
      "id": "position_override",
      "label": "Card Position",
      "options": [
        { "value": "default", "label": "Use App Settings" },
        { "value": "bottom-left", "label": "Bottom Left" },
        { "value": "bottom-right", "label": "Bottom Right" }
      ],
      "default": "default"
    }
  ]
}
{% endschema %}
